# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ══════════════════════════════════════════════════
# PHOENIX BINGO PLATFORM CONFIGURATION
# ══════════════════════════════════════════════════

# Server Port (Optional, default: 3000)
PORT="3000"

# MongoDB Connection URI (Required in production)
MONGO_URI=""

# Telegram Bot Token (Required for live bot integration)
TELEGRAM_BOT_TOKEN=""
# Enable polling for updates (default: true). Set to "false" if using webhooks or running multiple instances.
TELEGRAM_POLLING="true"

# Telegram Bot & Support Usernames (Optional branding placeholders)
PHOENIX_BOT_USERNAME="PHOENIX_BOT_USERNAME"
PHOENIX_SUPPORT_USERNAME="PHOENIX_SUPPORT_USERNAME"
SUPPORT_PHONE_NUMBER="0900000000"

# Application URLs
WEB_URL=""
WEBAPP_URL=""

# Android SMS Forwarder Webhook Secret (Required for automated bank deposit reconciliation)
SMS_WEBHOOK_SECRET=""

# Administrative & Finance Credentials (Required for dashboard access)
ADMIN_DEFAULT_PASS=""
FINANCE_DEFAULT_PASS=""
